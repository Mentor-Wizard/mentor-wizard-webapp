### Mentor Wizard Web Application - HTTP Client
### JetBrains HTTP Client file for testing application endpoints
###
### Environment Variables:
### - {{baseUrl}}: Application base URL (default: http://localhost)
### - {{csrfToken}}: CSRF token extracted from XSRF-TOKEN cookie
### - {{sessionCookie}}: Session cookie from login
###
### IMPORTANT: Before making POST/PATCH/DELETE requests:
### 1. First, make a GET request to any page (e.g., "Get CSRF Token" below)
### 2. The response will set XSRF-TOKEN cookie (URL-encoded)
### 3. Copy the XSRF-TOKEN cookie value and URL-decode it
### 4. Set the decoded value to {{csrfToken}} variable
### 5. Then make your POST/PATCH/DELETE request
###
### Alternative: Use the http-client.env.json file to manage tokens automatically

@baseUrl = http://localhost
@csrfToken =
@sessionCookie =

###############################################################################
### Public Pages
###############################################################################

### Welcome Page
GET {{baseUrl}}/
Accept: text/html

###

### List Mentor Profiles
GET {{baseUrl}}/profile-programs
Accept: text/html

###

### Get Mentor Profile by Slug
GET {{baseUrl}}/mentor/john-doe
Accept: text/html

###

### Get Mentor Review Page by Slug
GET {{baseUrl}}/review/john-doe
Accept: text/html

###

###############################################################################
### CSRF Token Setup (Run This First!)
###############################################################################

### Get CSRF Token
### This request will set the XSRF-TOKEN cookie
### After running this, check the response cookies for XSRF-TOKEN
### Copy its value (URL-encoded), decode it, and set {{csrfToken}} variable
### Example: If cookie is "abc%3D%3D", decode to "abc==" and set @csrfToken = abc==
GET {{baseUrl}}/register
Accept: text/html

> {%
    // Automatically extract and decode XSRF-TOKEN from response cookies
    const xsrfCookie = response.headers.valuesOf("Set-Cookie")
        .find(cookie => cookie.startsWith("XSRF-TOKEN="));

    if (xsrfCookie) {
        const tokenMatch = xsrfCookie.match(/XSRF-TOKEN=([^;]+)/);
        if (tokenMatch) {
            const encodedToken = tokenMatch[1];
            const decodedToken = decodeURIComponent(encodedToken);
            client.global.set("csrfToken", decodedToken);
            console.log("CSRF Token extracted and set: " + decodedToken);
        }
    }
%}

###

###############################################################################
### Authentication - Guest Routes
###############################################################################

### Get Registration Page (Alternative to Get CSRF Token)
GET {{baseUrl}}/register
Accept: text/html

###

### Register New User
### IMPORTANT: Run "Get CSRF Token" request first to set {{csrfToken}}
POST {{baseUrl}}/register
Content-Type: application/json
X-Requested-With: XMLHttpRequest
Accept: application/json
X-CSRF-TOKEN: {{csrfToken}}
Cookie: XSRF-TOKEN={{csrfToken}}

{
  "name": "John Doe",
  "email": "john@example.com",
  "password": "password123",
  "password_confirmation": "password123"
}

###

### Get Login Page
GET {{baseUrl}}/login
Accept: text/html

###

### Login User
POST {{baseUrl}}/login
Content-Type: application/json
X-Requested-With: XMLHttpRequest
Accept: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "email": "user@example.com",
  "password": "password",
  "remember": true
}

###

### Get Forgot Password Page
GET {{baseUrl}}/forgot-password
Accept: text/html

###

### Request Password Reset
POST {{baseUrl}}/forgot-password
Content-Type: application/json
X-Requested-With: XMLHttpRequest
Accept: application/json
X-CSRF-TOKEN: {{csrfToken}}

{
  "email": "user@example.com"
}

