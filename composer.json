{
    "name": "laravel/laravel",
    "description": "The skeleton application for the Laravel framework.",
    "license": "MIT",
    "type": "project",
    "keywords": [
        "laravel",
        "framework"
    ],
    "require": {
        "php": "^8.4",
        "filament/filament": "^4.0.20",
        "filament/spatie-laravel-media-library-plugin": "^4.0.20",
        "inertiajs/inertia-laravel": "^2.0.9",
        "laravel/framework": "^12.31.1",
        "laravel/octane": "^2.12.3",
        "laravel/pulse": "^1.4.3",
        "laravel/reverb": "^1.6",
        "laravel/socialite": "^5.23",
        "laravel/tinker": "^2.10.1",
        "lorisleiva/laravel-actions": "^2.9.1",
        "olssonm/l5-very-basic-auth": "^7.2",
        "opcodesio/log-viewer": "^3.19",
        "socialiteproviders/apple": "^5.7",
        "socialiteproviders/google": "^4.1",
        "spatie/laravel-medialibrary": "^11.15",
        "spatie/laravel-permission": "^6.21",
        "spatie/laravel-query-builder": "^6.3.5",
        "tightenco/ziggy": "^2.6"
    },
    "require-dev": {
        "barryvdh/laravel-ide-helper": "^3.6",
        "driftingly/rector-laravel": "^2.0.7",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.7.2",
        "laravel/boost": "^1.2.1",
        "laravel/pail": "^1.2.3",
        "laravel/pint": "^1.25.1",
        "laravel/telescope": "^5.12",
        "mockery/mockery": "^1.6.12",
        "nunomaduro/collision": "^8.8.2",
        "pestphp/pest": "4.1",
        "pestphp/pest-plugin-laravel": "^4.0",
        "tomasvotruba/cognitive-complexity": "^1.0",
        "wulfheart/laravel-actions-ide-helper": "^0.10.0"
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "scripts": {
        "post-install-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --tag=log-viewer-assets --tag=telescope-assets --ansi --force",
            "@ide-helper"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --tag=log-viewer-assets --tag=telescope-assets --ansi --force",
            "@ide-helper"
        ],
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi",
            "@php artisan filament:upgrade"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
        ],
        "ide-helper": [
            "@php artisan ide-helper:generate",
            "@php artisan ide-helper:meta",
            "@php artisan ide-helper:models -M",
            "@php artisan ide-helper:eloquent",
            "@php artisan ide-helper:actions"
        ],
        "phpstan": [
            "./vendor/bin/phpstan analyse --ansi --test"
        ],
        "pint": [
            "./vendor/bin/pint . --ansi --test"
        ],
        "pint:fix": [
            "./vendor/bin/pint . --ansi"
        ],
        "rector": [
            "./vendor/bin/rector process --ansi --dry-run"
        ],
        "rector:fix": [
            "./vendor/bin/rector process --ansi"
        ]
    }
}
