FROM dunglas/frankenphp:1.3-php8.4-alpine

# Install system dependencies
RUN apk update && apk add --no-cache \
    libstdc++ \
    libpq \
    libzip \
    icu \
    freetype \
    libjpeg-turbo \
    libpng \
    libavif \
    jpegoptim \
    optipng \
    pngquant \
    gifsicle \
    supervisor \
    git \
    nodejs=22.15.1-r0 \
    npm

# Install build dependencies
RUN apk add --no-cache --virtual .build-deps \
    $PHPIZE_DEPS \
    curl-dev \
    linux-headers \
    postgresql-dev \
    openssl-dev \
    pcre-dev \
    pcre2-dev \
    zlib-dev \
    libzip-dev \
    icu-dev \
    freetype-dev \
    libjpeg-turbo-dev \
    libpng-dev

# Install and configure PHP extensions
RUN pecl channel-update pecl.php.net && \
    docker-php-ext-configure zip && \
    docker-php-ext-install sockets zip exif pcntl intl pdo pdo_pgsql && \
    docker-php-ext-enable exif && \
    pecl install redis && \
    docker-php-ext-enable redis && \
    pecl install xdebug && \
    docker-php-ext-enable xdebug && \
    docker-php-ext-configure gd --with-freetype=shared --with-jpeg=shared && \
    docker-php-ext-install gd && \
    apk del .build-deps

# Configure PHP
RUN echo "memory_limit = 512M" >> /usr/local/etc/php/conf.d/memory-limit.ini

# Install Composer
COPY --from=composer:2.8.5 /usr/bin/composer /usr/bin/

# Setup Node.js and Yarn
RUN npm install -g corepack && \
    corepack enable && \
    corepack prepare yarn@4.6.0 --activate

# Copy supervisor configuration
COPY docker/php/supervisord/supervisord.conf /etc/

# Set working directory
WORKDIR /var/www

# Expose HTTP port (FrankenPHP serves on port 80 by default, but we'll use 8000)
EXPOSE 8000

# Use supervisor to manage processes
ENTRYPOINT ["supervisord", "--nodaemon", "--configuration", "/etc/supervisord.conf"]
