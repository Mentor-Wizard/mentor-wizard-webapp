{
  "name": "laravel/laravel",
  "description": "The skeleton application for the Laravel framework.",
  "license": "MIT",
  "type": "project",
  "keywords": [
    "laravel",
    "framework"
  ],
  "require": {
    "php": "^8.4",
    "ext-openssl": "*",
    "filament/filament": "4.3.1.0",
    "filament/spatie-laravel-media-library-plugin": "^4.3.1",
    "inertiajs/inertia-laravel": "^2.0.19",
    "laravel/framework": "^12.49",
    "laravel/octane": "^2.13.5",
    "laravel/pulse": "^1.5.0",
    "laravel/reverb": "^1.7.0",
    "laravel/socialite": "^5.24.2",
    "laravel/tinker": "^2.11.0",
    "lorisleiva/laravel-actions": "^2.9.1",
    "olssonm/l5-very-basic-auth": "^7.3",
    "opcodesio/log-viewer": "^3.21.1",
    "sabre/dav": "^4.7",
    "socialiteproviders/apple": "^5.7",
    "socialiteproviders/google": "^4.1",
    "spatie/laravel-medialibrary": "^11.17.10",
    "spatie/laravel-permission": "^6.24",
    "spatie/laravel-query-builder": "^6.4.1",
    "tightenco/ziggy": "^2.6",
    "ext-dom": "*",
    "ext-xmlreader": "*",
    "ext-libxml": "*"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^3.6.1",
    "driftingly/rector-laravel": "^2.1.9",
    "fakerphp/faker": "^1.24.1",
    "larastan/larastan": "^3.9.1",
    "laravel/boost": "^2.0.4",
    "laravel/pail": "^1.2.4",
    "laravel/pint": "^1.27.0",
    "laravel/telescope": "^5.16.1",
    "mockery/mockery": "^1.6.12",
    "nunomaduro/collision": "^8.8.3",
    "pestphp/pest": "^4.3.2",
    "pestphp/pest-plugin-laravel": "^4.0",
    "tomasvotruba/cognitive-complexity": "^1.0",
    "wulfheart/laravel-actions-ide-helper": "^0.10"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    },
    "bump-after-update": true,
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/telescope"
      ]
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --tag=log-viewer-assets --tag=telescope-assets --ansi --force",
      "@ide-helper"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --tag=log-viewer-assets --tag=telescope-assets --ansi --force",
      "@ide-helper"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan filament:upgrade"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
    ],
    "ide-helper": [
      "@php artisan ide-helper:generate",
      "@php artisan ide-helper:meta",
      "@php artisan ide-helper:models -M",
      "@php artisan ide-helper:eloquent",
      "@php artisan ide-helper:actions"
    ],
    "phpstan": [
      "./vendor/bin/phpstan analyse --ansi"
    ],
    "pint": [
      "./vendor/bin/pint . --ansi --test"
    ],
    "pint:fix": [
      "./vendor/bin/pint . --ansi"
    ],
    "rector": [
      "./vendor/bin/rector process --ansi --dry-run"
    ],
    "rector:fix": [
      "./vendor/bin/rector process --ansi"
    ]
  }
}
