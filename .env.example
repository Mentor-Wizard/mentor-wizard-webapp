# Development settings
XDEBUG_MODE=debug,coverage

# Calendar credential encryption keys (AES-256, base64-encoded 32-byte keys)
# CALENDAR_ENCRYPTION_KEY1 is the current active key used for encrypting new data
# CALENDAR_ENCRYPTION_KEY_PREVIOUS is the previous key used only for decrypting old data during rotation
CALENDAR_ENCRYPTION_KEY1=
CALENDAR_ENCRYPTION_KEY_PREVIOUS=

# Microsoft Outlook — multi-tenant Azure AD app credentials
# Register an app at https://portal.azure.com with "Accounts in any organizational directory and personal Microsoft accounts"
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# Google Calendar — app-level OAuth credentials (optional)
# When set, all users connect via this shared app (Google provider).
# Leave empty to use the per-user credential flow (GooglePersonalApp provider).
# Only one of the two Google options should be active at a time.
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=

# Integration test credentials (optional, for running live provider tests)
TEST_OUTLOOK_ACCESS_TOKEN=
TEST_OUTLOOK_REFRESH_TOKEN=
TEST_OUTLOOK_CALENDAR_ID=
TEST_GOOGLE_ACCESS_TOKEN=
TEST_GOOGLE_REFRESH_TOKEN=
TEST_GOOGLE_CLIENT_ID=
TEST_GOOGLE_CLIENT_SECRET=
TEST_GOOGLE_CALENDAR_ID=
TEST_APPLE_ID=
TEST_APPLE_APP_PASSWORD=
TEST_APPLE_CALENDAR_URL=

# MCP Server API Keys
