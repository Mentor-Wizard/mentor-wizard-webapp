{
  "name": "mentor-wizard/mentor-wizard",
  "description": "Mentors platform for mentoring students.",
  "license": "MIT",
  "type": "project",
  "keywords": [
    "laravel",
    "framework"
  ],
  "require": {
    "php": "^8.5",
    "ext-dom": "*",
    "ext-libxml": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-xmlreader": "*",
    "filament/filament": "^5.6.5",
    "filament/spatie-laravel-media-library-plugin": "^5.6.5",
    "inertiajs/inertia-laravel": "^2.0.24",
    "laravel/framework": "^13.11.2",
    "laravel/octane": "^2.17.4",
    "laravel/pulse": "^1.7.3",
    "laravel/reverb": "^1.10.2",
    "laravel/socialite": "^5.27.0",
    "laravel/tinker": "^3.0.2",
    "lorisleiva/laravel-actions": "^2.10.1",
    "olssonm/l5-very-basic-auth": "^7.4",
    "opcodesio/log-viewer": "^3.24.0",
    "sabre/dav": "^4.7",
    "socialiteproviders/apple": "^5.10",
    "socialiteproviders/google": "^4.1",
    "spatie/laravel-medialibrary": "^11.22.1",
    "spatie/laravel-permission": "^6.25",
    "spatie/laravel-query-builder": "^6.4.4",
    "stevebauman/purify": "^6.3.2",
    "tightenco/ziggy": "^2.6.2"
  },
  "require-dev": {
    "barryvdh/laravel-ide-helper": "^3.7.0",
    "driftingly/rector-laravel": "^2.4.0",
    "fakerphp/faker": "^1.24.1",
    "larastan/larastan": "^3.9.6",
    "laravel/boost": "^2.4.8",
    "laravel/pail": "^1.2.6",
    "laravel/pint": "^1.29.1",
    "laravel/telescope": "^5.20.0",
    "mockery/mockery": "^1.6.12",
    "nunomaduro/collision": "^8.9.4",
    "pestphp/pest": "^4.7.0",
    "pestphp/pest-plugin-laravel": "^4.1",
    "tomasvotruba/cognitive-complexity": "^1.1",
    "wulfheart/laravel-actions-ide-helper": "^0.11"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/",
      "Database\\Seeders\\": "database/seeders/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "config": {
    "allow-plugins": {
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "pestphp/pest-plugin": true,
      "php-http/discovery": true
    },
    "bump-after-update": true,
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/telescope"
      ]
    }
  },
  "scripts": {
    "post-install-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --tag=log-viewer-assets --tag=telescope-assets --ansi --force",
      "@ide-helper"
    ],
    "post-update-cmd": [
      "@php artisan vendor:publish --tag=laravel-assets --tag=log-viewer-assets --tag=telescope-assets --ansi --force",
      "@ide-helper"
    ],
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi",
      "@php artisan filament:upgrade"
    ],
    "post-root-package-install": [
      "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
    ],
    "post-create-project-cmd": [
      "@php artisan key:generate --ansi",
      "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
      "@php artisan migrate --graceful --ansi"
    ],
    "dev": [
      "Composer\\Config::disableProcessTimeout",
      "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" --names=server,queue,logs,vite"
    ],
    "ide-helper": [
      "@php artisan ide-helper:generate",
      "@php artisan ide-helper:meta",
      "@php artisan ide-helper:models -M",
      "@php artisan ide-helper:eloquent",
      "@php artisan ide-helper:actions"
    ],
    "phpstan": [
      "./vendor/bin/phpstan analyse --ansi"
    ],
    "pint": [
      "./vendor/bin/pint . --ansi --test"
    ],
    "pint:fix": [
      "./vendor/bin/pint . --ansi"
    ],
    "rector": [
      "./vendor/bin/rector process --ansi --dry-run"
    ],
    "rector:fix": [
      "./vendor/bin/rector process --ansi"
    ]
  }
}
