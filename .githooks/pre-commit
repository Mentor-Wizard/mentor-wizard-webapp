#!/bin/sh

# Pre-commit hook to run code quality tools
# Based on the original Husky pre-commit hook

# Get list of staged files before running formatters
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

# Run code quality tools
docker compose exec -T app composer rector:fix
docker compose exec -T app composer pint:fix
docker compose exec -T app yarn prettier:fix

# Only add files that were:
# 1. Originally staged AND
# 2. Modified by the formatters
for file in $STAGED_FILES; do
    if [ -f "$file" ]; then
        git add "$file"
    fi
done
